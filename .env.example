# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed by the leader routes (they read every member's preferences)
# and by trip deletion. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio
GEMINI_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
# Optional. Defaults to the "Rachel" voice.
ELEVENLABS_VOICE_ID=
